# Stripe restricted key (rk_...) with read-only permissions.
# Create at https://dashboard.stripe.com/apikeys (Restricted keys → New).
# Grant only: Customers (Read), Invoices (Read), Subscriptions (Read),
# Charges (Read), Balance (Read).
STRIPE_API_KEY=rk_live_...

# Cloudflare API token scoped to Billing:Read (and Zone:Read for zone subs).
# Create at https://dash.cloudflare.com/profile/api-tokens.
# DO NOT use a global API key.
CLOUDFLARE_API_TOKEN=...
